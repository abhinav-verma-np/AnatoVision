# ============================
# AnatoVision — root .gitignore
# ============================

# --- Environment & secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Node / Frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / Backend ---
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage

# --- Datasets (large binary/medical imaging data should never be committed) ---
datasets/raw/
datasets/cache/
datasets/*.dcm
datasets/*.nii
datasets/*.nii.gz

# --- Docker ---
docker/volumes/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
*.log
logs/

# Per-collection export resume state — machine/run-specific, not committed.
logs/export_checkpoint.json

# --- Z-Anatomy asset pipeline ---
# Raw dataset is downloaded manually by each developer, never committed.
assets/raw/*
!assets/raw/.gitkeep
assets/processed/*
!assets/processed/.gitkeep
# Generated GLB output is large binary data — reproducible via the pipeline,
# not committed. manifest.json IS committed (small, and generated by the
# same script) so the frontend has something to read even before assets exist.
frontend/public/models/**/*.glb
frontend/public/models/**/*.compressed.glb
