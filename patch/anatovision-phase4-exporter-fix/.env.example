# =====================================================================
# AnatoVision — root environment reference
# =====================================================================
# This file is a REFERENCE ONLY. It documents every environment variable
# used across the monorepo in one place so new contributors can see the
# full picture at a glance.
#
# You do NOT edit this file directly. Instead:
#   - copy frontend/.env.example -> frontend/.env.local
#   - copy backend/.env.example  -> backend/.env
#   - copy this file             -> .env   (used by docker-compose.yml)
#
# Never commit real secrets. This file must only ever contain placeholders.
# =====================================================================

# --- Shared / general ---
APP_ENV=development

# --- Frontend (consumed by Next.js, must be prefixed NEXT_PUBLIC_ to reach the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (consumed by FastAPI) ---
DATABASE_URL=postgresql://anatovision:anatovision@localhost:5432/anatovision
REDIS_URL=redis://localhost:6379/0

# --- Docker Compose (Postgres container init) ---
POSTGRES_USER=anatovision
POSTGRES_PASSWORD=anatovision
POSTGRES_DB=anatovision
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
