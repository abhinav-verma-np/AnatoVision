# Copy this file to backend/.env for local development.
# Loaded via pydantic-settings (see app/core/config.py). Never commit real
# secrets or production credentials here.

APP_ENV=development

# Only plumbed through in Phase 1 — no DB/Redis client is opened yet.
DATABASE_URL=postgresql://anatovision:anatovision@localhost:5432/anatovision
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of browser origins allowed to call this API.
# Required for the frontend's connection test to succeed without a CORS
# rejection — add your deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:3000
